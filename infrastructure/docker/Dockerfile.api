# Build stage - runs on native architecture
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0@sha256:ea8bde36c11b6e7eec2656d0e59101d4462f6bd630730f2c8201ed0572b295d5 AS build
ARG TARGETARCH
WORKDIR /src

# Copy project files
COPY Directory.Build.props ./
COPY CAU.Eleitoral.Api/CAU.Eleitoral.Api.csproj CAU.Eleitoral.Api/
COPY CAU.Eleitoral.Api/packages.lock.json CAU.Eleitoral.Api/
COPY CAU.Eleitoral.Application/CAU.Eleitoral.Application.csproj CAU.Eleitoral.Application/
COPY CAU.Eleitoral.Application/packages.lock.json CAU.Eleitoral.Application/
COPY CAU.Eleitoral.Domain/CAU.Eleitoral.Domain.csproj CAU.Eleitoral.Domain/
COPY CAU.Eleitoral.Domain/packages.lock.json CAU.Eleitoral.Domain/
COPY CAU.Eleitoral.Infrastructure/CAU.Eleitoral.Infrastructure.csproj CAU.Eleitoral.Infrastructure/
COPY CAU.Eleitoral.Infrastructure/packages.lock.json CAU.Eleitoral.Infrastructure/

# Restore packages for target architecture
RUN dotnet restore CAU.Eleitoral.Api/CAU.Eleitoral.Api.csproj \
    -a $TARGETARCH --locked-mode

# Copy source code
COPY . .

# Build and publish for target architecture
RUN dotnet publish CAU.Eleitoral.Api/CAU.Eleitoral.Api.csproj \
    -c Release -o /app/publish -a $TARGETARCH --no-restore

# Runtime stage - runs on target architecture
FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:7644f992230d35cf230017189d4038c0ae0f7388b13f4f7ae1900a155bafb597 AS runtime
WORKDIR /app

# Npgsql VerifyFull requires the Amazon RDS root CAs to be present explicitly.
# Keep the regional bundle content-pinned so certificate verification never
# falls back to Trust Server Certificate=true. curl is also required by the
# ECS container health check below.
ARG RDS_CA_BUNDLE_URL=https://truststore.pki.rds.amazonaws.com/us-east-1/us-east-1-bundle.pem
ARG RDS_CA_BUNDLE_SHA256=b1711d12bae51838581281e23b6cb97b1074016873b4dafc80ed14002462dd77
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/certs \
    && curl --fail --silent --show-error --location \
        "${RDS_CA_BUNDLE_URL}" \
        --output /tmp/us-east-1-bundle.pem \
    && echo "${RDS_CA_BUNDLE_SHA256}  /tmp/us-east-1-bundle.pem" \
        | sha256sum --check --strict \
    && install -o root -g root -m 0444 \
        /tmp/us-east-1-bundle.pem /app/certs/us-east-1-bundle.pem \
    && rm -f /tmp/us-east-1-bundle.pem

# Copy published app
COPY --from=build --chown=app:app /app/publish .

# Ensure runtime user can create/update SQLite database and WAL files.
RUN mkdir -p /app && chown -R app:app /app

# Use built-in app user
USER app

# Set environment variables
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
ENV PGSSLROOTCERT=/app/certs/us-east-1-bundle.pem

EXPOSE 8080

ENTRYPOINT ["dotnet", "CAU.Eleitoral.Api.dll"]
