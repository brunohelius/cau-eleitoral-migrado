# Build stage
FROM public.ecr.aws/docker/library/node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS build
WORKDIR /workspace

# Keep the container toolchain aligned with the repository packageManager.
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate

# Install from the monorepo lockfile before copying application sources.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
COPY apps/public/package.json apps/public/package.json
RUN pnpm install --frozen-lockfile --filter @cau-eleitoral/public...

# Copy and build only the public application.
COPY apps/public apps/public
WORKDIR /workspace/apps/public
RUN pnpm build

FROM public.ecr.aws/nginx/nginx:alpine@sha256:14bdc5d78859f7dd48cda3d5f8d1f43e859eff90d016936a5c3e8a041a532afd AS runtime

COPY apps/public/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /workspace/apps/public/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
